{
  "lock-source-after-plan": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/scripts/lock_source.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
